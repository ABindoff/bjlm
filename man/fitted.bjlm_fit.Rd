\deqn{\hat{\mu}_a^{(s)} = \frac{1}{N} \sum_{i=1}^N \hat{Y}_i(a)^{(s)}}
\deqn{\text{RR}^{(s)} = \hat{\mu}_1^{(s)} / \hat{\mu}_0^{(s)}, \qquad \text{ATE}^{(s)} = \hat{\mu}_1^{(s)} - \hat{\mu}_0^{(s)}}
